# Norfolk ServiceHub configuration. Copy to `.env` and adjust. Never commit real secrets.

# HTTP port.
PORT=8080
# SQLite database, blobs and backups live here.
DATA_DIR=./data
# Public URL used in links and checkout return URLs.
PUBLIC_BASE_URL=http://localhost:8080
# Server-to-server calls to /mock/** and webhooks (defaults to http://127.0.0.1:$PORT).
# INTERNAL_BASE_URL=http://127.0.0.1:8080
# Built React app (served with index.html fallback).
# WEB_DIST=../web/dist # local override; Docker uses /app/web
# Seed files (holidays.csv, …). Defaults to ./seed-data, then server/seed-data.
# SEED_DATA_DIR=./seed-data

# Demo mode: persona login, demo authenticator, scheduled data reset, demo banner.
DEMO_MODE=false
# Reset interval in demo mode (0 = never).
DEMO_RESET_HOURS=6
# Demo mode only: after this RFC 3339 instant the site shows "this demonstration has ended".
# DEMO_ENDS_AT=2026-12-31T23:59:59Z
# Repository link shown on the "demonstration has ended" page.
# REPO_URL=https://github.com/your-org/norfolk-servicehub
# Show the mock AI service-suggestion helper.
AI_ENABLED=true

# Set to false for plain-http local development.
COOKIE_SECURE=true
# Take the client IP from the first X-Forwarded-For hop (true behind a reverse proxy).
TRUST_PROXY=true

# Random per start when unset (fine for the demo; set fixed values to survive restarts).
# WEBHOOK_SECRET=
# MOCK_API_KEY=

# Log filter (tracing-subscriber EnvFilter syntax).
# RUST_LOG=info,sqlx=warn
