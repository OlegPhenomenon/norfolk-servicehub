# Copy to .kamal/secrets (git-ignored). Values come from your shell environment:
#   export KAMAL_REGISTRY_PASSWORD=$(gh auth token)   # needs write:packages
#   export WEBHOOK_SECRET=$(openssl rand -hex 32) MOCK_API_KEY=$(openssl rand -hex 32)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
WEBHOOK_SECRET=$WEBHOOK_SECRET
MOCK_API_KEY=$MOCK_API_KEY
