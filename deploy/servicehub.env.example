# Norfolk ServiceHub — production demo environment for norfolk.shelfcompass.com.
#
#   cp deploy/servicehub.env.example deploy/servicehub.env
#
# then fill in WEBHOOK_SECRET / MOCK_API_KEY and DEMO_ENDS_AT below.
# deploy/servicehub.env contains secrets — do NOT commit it.
# (docker compose reads this file via env_file; PORT/DATA_DIR/WEB_DIST come
# from the Dockerfile and do not need to be set here.)

# --- demo mode -------------------------------------------------------------
DEMO_MODE=true
# Wipe and re-seed the demo data every N hours (0 = never).
DEMO_RESET_HOURS=6
# After this RFC 3339 instant the site serves "this demonstration has ended".
# Set to one month after launch, e.g. 2026-11-07T00:00:00Z.
DEMO_ENDS_AT=
# Source link shown on the "demonstration has ended" page.
REPO_URL=https://github.com/OlegPhenomenon/norfolk-servicehub

# --- public URL / reverse proxy --------------------------------------------
PUBLIC_BASE_URL=https://norfolk.shelfcompass.com
# Secure session cookies — required behind HTTPS.
COOKIE_SECURE=true
# Client IP comes from X-Forwarded-For set by nginx/Caddy.
TRUST_PROXY=true

# --- secrets ---------------------------------------------------------------
# Generate each value with:  openssl rand -hex 32
# (unset = random per start; fixed values keep webhook/mocks stable across
# restarts and are required for a credible demo)
WEBHOOK_SECRET=
MOCK_API_KEY=

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info
